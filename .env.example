# Copy to .env.local and adjust. .env.local is gitignored; this file is not.
#
# SECURITY: Vite only exposes variables prefixed with VITE_ to client code, and
# it INLINES them into the shipped JavaScript bundle. Anything listed here is
# public by definition — readable by anyone who opens devtools. No API key,
# token, password or private URL ever belongs in this file or in any VITE_ var.

# Cal.com team slug used to build the per-doctor booking links, e.g. the
# "jvd-dental" in "jvd-dental/jeton-selimi-goce-delchev". Must match the team
# handle in Cal.com. Today src/data/clinic.js hardcodes these slugs; point that
# data at import.meta.env.VITE_CAL_TEAM_SLUG to switch teams per environment.
VITE_CAL_TEAM_SLUG=jvd-dental

# Canonical public origin, no trailing slash. Used for absolute URLs in
# canonical/Open Graph tags, sitemap generation and structured data.
# PLACEHOLDER: confirm the real domain before launch.
VITE_SITE_URL=https://jvddental.mk


# ─────────────────────────────────────────────────────────────────────────────
# BOOKING SOURCE — both flags are for pre-launch demos only.
#
# Precedence, highest first:
#   1. VITE_CAL_DEMO_LINK   a real Cal.com link used for EVERY doctor/location
#                           pair. One throwaway event type is then enough to
#                           demo the genuine embed.
#   2. VITE_DEMO_BOOKING=1  render the built-in DemoCalendar instead — sample
#                           availability, an on-screen "demo mode" banner, and
#                           no third party involved. Nothing is ever booked.
#   3. neither set          normal behaviour: the per-combination Cal.com slugs
#                           in src/data/clinic.js.
#
# Leave BOTH unset in production. Set one only on a demo deployment.
# ─────────────────────────────────────────────────────────────────────────────

# VITE_DEMO_BOOKING=1
# VITE_CAL_DEMO_LINK=yourname/consultation
