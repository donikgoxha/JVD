# Committed on purpose. Vite reads this at build time for `npm run build`, so
# every Vercel deployment built from a commit picks it up automatically — no
# dashboard setting, no CLI flag, no state living outside the repo.
#
# SECURITY: VITE_-prefixed values are inlined into the public JavaScript bundle.
# Only put things here that are safe to publish. Secrets belong in the Vercel
# dashboard as non-VITE_ variables, never in this file.

# ─────────────────────────────────────────────────────────────────────────────
# BOOKING MODE
#
#   phone  no calendar; /book resolves the patient's clinic + dentist choice to
#          the right phone number. Correct while no Cal.com account exists — a
#          live site must never show availability it cannot honour.
#   cal    the real Cal.com embed, using the per-doctor slugs in clinic.js.
#   demo   local sample calendar behind a banner. INTERNAL REVIEW ONLY. Never
#          deploy this publicly: patients cannot tell a demo calendar from a
#          real one, and a "booking" that reaches nobody means a missed
#          appointment.
#
# Switching to Cal.com is one commit: create the three event types
# (docs/BOOKING_SETUP.md), then set this to `cal`.
# ─────────────────────────────────────────────────────────────────────────────
VITE_BOOKING_MODE=phone

# Canonical origin. Used for canonical/og:url tags and structured data.
# Change this the day a real domain is pointed at the site, and update
# public/robots.txt and public/sitemap.xml in the same commit.
VITE_SITE_URL=https://jvd-dental.vercel.app
